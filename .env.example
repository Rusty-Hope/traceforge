# ── Storage ──────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./traceforge.db

# ── Background LLM worker (OpenRouter) — Phase 2 ────────────────
OPENROUTER_API_KEY=sk-or-v1-change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.3-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=450
LLM_ENABLED=true

# Offline dev: `make mock-llm`, then set:
#   OPENROUTER_BASE_URL=http://127.0.0.1:9938/v1
#   OPENROUTER_API_KEY=mock

# ── Triage worker cadence ───────────────────────────────────────
TRIAGE_INTERVAL_S=4
TRIAGE_MIN_OCCURRENCES=3
TRIAGE_BATCH=2

# ── CORS (frontend dev server) ─────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Data hygiene & integrations ────────────────────────────────
RETENTION_HOURS=24
# Optional shared secret for POST /api/ingest (Vector / Fluent Bit / your apps)
INGEST_TOKEN=
# Webhook fired on triaged incidents at/above ALERT_MIN_SEVERITY ("high"|"critical")
# Demo receiver: make mock-llm, then ALERT_WEBHOOK_URL=http://127.0.0.1:9938/alerts
ALERT_WEBHOOK_URL=
ALERT_MIN_SEVERITY=high

# ── Local ML engine ─────────────────────────────────────────────
WINDOW_SIZE_S=15
BASELINE_MIN_WINDOWS=30
RETRAIN_EVERY=50
ANOMALY_THRESHOLD=0.62
CONTAMINATION=0.02
CLUSTER_SIMILARITY=0.60

# ── Simulator ───────────────────────────────────────────────────
SIMULATE_ENABLED=true
SIMULATE_INTERVAL_S=0.5
SIM_STEP_S=5
